<script>
var scv=document.getElementById('spark'),sctx=scv.getContext('2d');
function sresize(){scv.width=innerWidth;scv.height=innerHeight}
sresize();addEventListener('resize',sresize);
var sp=[];
for(var i=0;i<80;i++)sp.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*2+.5,vx:(Math.random()-.5)*.5,vy:-(Math.random()*.8+.2),life:Math.random()*100});
function sanim(){
  sctx.clearRect(0,0,scv.width,scv.height);
  sp.forEach(function(p){
    p.x+=p.vx;p.y+=p.vy;p.life--;
    if(p.life<0||p.y<-10){p.y=scv.height+10;p.x=Math.random()*scv.width;p.life=Math.random()*100+50}
    var a=Math.min(1,p.life/50)*.6;
    sctx.beginPath();sctx.arc(p.x,p.y,p.r,0,7);
    sctx.fillStyle='rgba(244,208,63,'+a+')';sctx.fill();
  });
  requestAnimationFrame(sanim);
}
sanim();
const obs=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)e.target.classList.add('show')})},{threshold:.1});
document.querySelectorAll('.fade').forEach(function(el){obs.observe(el)});
async function load(){
  try{
    const r=await fetch('/api/status');const d=await r.json();
    animate('truth',d.stats.truths);animate('truth2',d.stats.truths);
    animate('nodes',d.stats.nodes);animate('audit',d.stats.audit_logs);
  }catch(e){}
}
function animate(id,t){const el=document.getElementById(id);if(!el)return;let c=0;const s=Math.max(1,Math.ceil(t/50));const iv=setInterval(()=>{c+=s;if(c>=t){el.textContent=t.toLocaleString();clearInterval(iv)}else el.textContent=c},20)}
load();
addEventListener('scroll',function(){
var h=document.documentElement;
document.getElementById('pg').style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight)*100)+'%';
document.getElementById('top').style.display=h.scrollTop>300?'block':'none';
});
setInterval(function(){document.getElementById('hb').textContent=new Date().toLocaleTimeString('zh-CN')},1000);
const thoughts=['>> 因果链巡检完成','>> Merkle链校验：完整','>> 等待GPU实例开启','>> 共享大脑同步完成','>> 下一周期图像生成待命'];
let ti=0;
setInterval(()=>{const el=document.getElementById('think');const lines=el.querySelectorAll('.line');if(lines.length>5)lines[0].remove();const div=document.createElement('div');div.className='line';div.innerHTML='<span class="p">></span> '+thoughts[ti++%thoughts.length];el.appendChild(div)},4000);
</script>
</body></html>
