{
  "operator_id": "OP-WORKER-TRIGGER-001",
  "name": "Worker部署触发算子",
  "version": "v1.0",
  "hook_type": "local_file_trigger",
  "entry_script": "/home/user/ZONGYUAN-ROOT/scripts/worker_auto_deploy_timer.sh",
  "input_schema": {
