<style>
:root{--ink:#0a0a0f;--ink2:#12121a;--ink3:#1a1a24;--gold:#d4af37;--gold2:#f0d78c;--red:#c41e3a;--text:#f8f4ec;--dim:rgba(248,244,236,.6)}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:"PingFang SC","Microsoft YaHei",sans-serif;background:var(--ink);color:var(--text);line-height:1.8;overflow-x:hidden}
a{text-decoration:none;color:inherit}
.nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(10,10,15,.95);backdrop-filter:blur(10px);border-bottom:1px solid rgba(212,175,55,.2);padding:15px 40px}
.nav-inner{display:flex;align-items:center;justify-content:space-between;max-width:1200px;margin:0 auto}
.brand{color:var(--gold);font-size:1.3em;font-weight:bold;letter-spacing:2px}
.nav-links{display:flex;gap:20px;list-style:none}
.nav-links a{color:var(--dim);font-size:14px}
.nav-links a:hover{color:var(--gold)}
.hero{padding:120px 0 60px;text-align:center;position:relative}
.hero-frame{display:inline-block;padding:40px 64px;border:1px solid rgba(212,175,55,.2);position:relative;background:rgba(10,10,15,.4)}
.hero-frame::before{content:'';position:absolute;top:8px;left:8px;right:8px;bottom:8px;border:1px solid rgba(212,175,55,.2);pointer-events:none}
.corner{position:absolute;width:14px;height:14px;border:1.5px solid var(--gold)}
.tl{top:-1px;left:-1px;border-right:none;border-bottom:none}.tr{top:-1px;right:-1px;border-left:none;border-bottom:none}
.bl{bottom:-1px;left:-1px;border-right:none;border-top:none}.br{bottom:-1px;right:-1px;border-left:none;border-top:none}
.hero h1{font-size:clamp(36px,5vw,52px);font-weight:700;color:var(--gold);margin:16px 0;letter-spacing:6px}
.sub{font-size:15px;color:var(--dim);max-width:500px;margin:0 auto}
.seal{display:inline-block;width:44px;height:44px;background:var(--red);color:#fff;writing-mode:vertical-rl;text-align:center;line-height:44px;font-size:13px;border-radius:4px;margin-top:12px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:1200px;margin:0 auto;padding:20px 40px}
.card{background:var(--ink3);border:1px solid rgba(212,175,55,.15);border-radius:16px;padding:24px;transition:.3s}
.card:hover{transform:translateY(-5px);box-shadow:0 10px 40px rgba(212,175,55,.15);border-color:rgba(212,175,55,.3)}
.card .badge{display:inline-block;padding:3px 10px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.2);border-radius:6px;font-size:11px;color:var(--gold);margin-bottom:12px}
.card h3{font-size:18px;color:var(--gold2);margin-bottom:8px}
.card p{font-size:13px;color:var(--dim)}
.card.legendary{border-color:rgba(212,175,55,.4)}
.card.legendary::before{content:'';display:block;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:-24px -24px 16px}
.card .hash{margin-top:12px;font-family:monospace;font-size:10px;color:rgba(212,175,55,.4)}
.cred{max-width:1200px;margin:40px auto;padding:24px;border:1px solid rgba(212,175,55,.15);border-radius:12px;background:rgba(10,10,15,.5);text-align:center}
.cred h3{color:var(--gold2);margin-bottom:8px}
.cred .row{color:var(--dim);font-size:12px;font-family:monospace;margin:4px 0}
.footer{border-top:1px solid rgba(212,175,55,.1);padding:32px 0;text-align:center;color:rgba(248,244,236,.4);font-size:12px}
@media(max-width:768px){.grid{grid-template-columns:1fr}.nav{padding:12px 20px}}
</style></head><body>
