.stat-label{font-size:12px;color:#606078;margin-top:4px;letter-spacing:2px}
.hero-btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.btn{padding:14px 32px;font-size:14px;letter-spacing:3px;border:1px solid #d4af37;color:#d4af37;text-decoration:none;transition:.3s;white-space:nowrap}
.btn:hover{background:#d4af37;color:#0a0a0f}
.btn-dim{border-color:rgba(212,175,55,.3);color:#a0a0b8}
.btn-dim:hover{border-color:#d4af37;color:#d4af37;background:transparent}
.section{padding:80px 20px;max-width:900px;margin:0 auto}
.section-title{font-family:'Noto Serif SC',serif;font-size:28px;font-weight:700;text-align:center;margin-bottom:8px;color:#e8e8f0}
.section-sub{text-align:center;color:#8b7355;font-size:12px;letter-spacing:4px;margin-bottom:40px}
.divider{width:60px;height:2px;background:linear-gradient(90deg,transparent,#d4af37,transparent);margin:0 auto 40px}
.flow{background:rgba(20,20,35,.8);border:1px solid rgba(212,175,55,.2);border-radius:12px;padding:24px;margin-bottom:40px}
.flow-title{font-size:11px;color:#d4af37;letter-spacing:3px;margin-bottom:16px;font-family:monospace}
.flow-row{display:flex;justify-content:space-between;font-family:monospace;font-size:13px;padding:6px 0;border-bottom:1px solid rgba(212,175,55,.05)}
.flow-row:last-child{border:none}
.flow-row .k{color:#606078}
.flow-row .v{color:#f4d03f}
.think{font-family:monospace;font-size:12px;color:#606078;line-height:2.2;min-height:100px}
.think .line{opacity:0;animation:lineIn .5s forwards}
@keyframes lineIn{to{opacity:1}}
.think .p{color:#d4af37}
.ft{text-align:center;padding:40px;font-size:11px;color:#606078;line-height:2;font-family:monospace}
.fade{opacity:0;transform:translateY(30px);transition:opacity .8s,transform .8s}
.fade.show{opacity:1;transform:translateY(0)}
.wave{position:fixed;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#d4af37,transparent);animation:wave 4s linear infinite;z-index:101}
.progress{position:fixed;top:0;left:0;height:2px;background:#d4af37;z-index:102;transition:width .1s}
.top{position:fixed;bottom:30px;right:20px;width:40px;height:40px;background:#c9a961;color:#000;border:none;border-radius:50%;cursor:pointer;font-size:18px;display:none;z-index:101}
.online{display:inline-block;width:8px;height:8px;background:#2ecc71;border-radius:50%;margin-right:5px;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
@media(max-width:600px){.hero-stats{gap:24px}.stat-num{font-size:24px}.nav-links{gap:12px}.nav-links a{font-size:11px;letter-spacing:1px}.nav-brand{font-size:14px;letter-spacing:1px}.nav-brand img{width:28px;height:28px}.nav{padding:8px 16px}.section{padding:50px 15px}.grid{grid-template-columns:repeat(auto-fill,minmax(110px,1fr))}}
