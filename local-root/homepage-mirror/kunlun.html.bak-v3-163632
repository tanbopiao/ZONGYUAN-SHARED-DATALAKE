<style>
:root{
  --ink:#0a0a0f;--ink2:#12121a;--ink3:#1a1a24;
  --gold:#d4af37;--gold2:#f0d78c;--red:#c41e3a;--rose:#e8385a;
  --text:#f8f4ec;--dim:rgba(248,244,236,.6)
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:"PingFang SC","Microsoft YaHei",serif;background:var(--ink);color:var(--text);line-height:1.8;overflow-x:hidden;min-height:100vh}
a{text-decoration:none;color:inherit}

/* 背景云雾动效 */
.cloud{position:fixed;inset:0;z-index:-1;overflow:hidden;background:radial-gradient(ellipse at 50% -10%,rgba(212,175,55,.12) 0%,transparent 55%),radial-gradient(ellipse at 80% 100%,rgba(196,30,58,.08) 0%,transparent 50%),var(--ink)}
.cloud::before,.cloud::after{content:'';position:absolute;width:60vw;height:60vw;border-radius:50%;filter:blur(80px);opacity:.18;animation:drift 24s linear infinite}
.cloud::before{background:radial-gradient(circle,#d4af37,transparent 60%);top:-20%;left:-10%}
.cloud::after{background:radial-gradient(circle,#c41e3a,transparent 60%);bottom:-20%;right:-10%;animation-duration:32s;animation-direction:reverse}
@keyframes drift{0%{transform:translate(0,0)}50%{transform:translate(8vw,6vh)}100%{transform:translate(0,0)}}

/* 导航 */
.nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(10,10,15,.92);backdrop-filter:blur(12px);border-bottom:1px solid rgba(212,175,55,.2);padding:14px 40px}
.nav-inner{display:flex;align-items:center;justify-content:space-between;max-width:1280px;margin:0 auto}
.brand{color:var(--gold);font-size:1.25em;font-weight:bold;letter-spacing:3px}
.nav-links{display:flex;gap:28px;list-style:none}
.nav-links a{color:var(--dim);font-size:14px;letter-spacing:2px;transition:color .2s}
.nav-links a:hover{color:var(--gold)}
.nav-links a.active{color:var(--gold)}

/* Hero */
.hero{padding:140px 24px 60px;text-align:center;position:relative}
.hero-frame{display:inline-block;padding:48px 72px;border:1px solid rgba(212,175,55,.25);position:relative;background:rgba(10,10,15,.5);backdrop-filter:blur(4px)}
.hero-frame::before{content:'';position:absolute;inset:8px;border:1px solid rgba(212,175,55,.15);pointer-events:none}
.corner{position:absolute;width:14px;height:14px;border:1.5px solid var(--gold)}
.tl{top:-1px;left:-1px;border-right:none;border-bottom:none}
.tr{top:-1px;right:-1px;border-left:none;border-bottom:none}
.bl{bottom:-1px;left:-1px;border-right:none;border-top:none}
.br{bottom:-1px;right:-1px;border-left:none;border-top:none}
.hero .ver{font-size:11px;color:var(--gold);letter-spacing:4px;font-family:monospace;margin-bottom:12px}
.hero h1{font-size:clamp(40px,6vw,64px);font-weight:700;color:var(--gold2);margin:12px 0;letter-spacing:12px;text-shadow:0 0 40px rgba(212,175,55,.3)}
.hero .sub{font-size:15px;color:var(--dim);max-width:560px;margin:0 auto;letter-spacing:3px}
.cta{display:inline-block;margin-top:28px;padding:12px 32px;background:linear-gradient(135deg,var(--gold),#b8941f);color:#1a1a24;font-weight:700;border-radius:8px;letter-spacing:3px;transition:transform .2s,box-shadow .2s}
.cta:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(212,175,55,.4)}

/* 区块标题 */
.section{max-width:1280px;margin:60px auto;padding:0 24px}
.section-head{display:flex;align-items:center;gap:16px;margin-bottom:28px}
.section-head h2{font-size:24px;color:var(--gold2);letter-spacing:6px}
.section-head .line{flex:1;height:1px;background:linear-gradient(90deg,rgba(212,175,55,.4),transparent)}
.section-head .en{font-size:11px;color:var(--dim);letter-spacing:3px;font-family:monospace}

/* 角色卡 */
.roles{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.role{background:var(--ink3);border:1px solid rgba(212,175,55,.18);border-radius:14px;overflow:hidden;transition:transform .3s,box-shadow .3s,border-color .3s}
.role:hover{transform:translateY(-6px);border-color:rgba(212,175,55,.5);box-shadow:0 12px 36px rgba(212,175,55,.15)}
.role-img{width:100%;aspect-ratio:3/4;overflow:hidden;background:#000}
.role-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.role:hover .role-img img{transform:scale(1.05)}
.role-info{padding:16px 18px}
.role-name{font-size:16px;color:var(--gold2);letter-spacing:3px;font-weight:700}
.role-title{font-size:12px;color:var(--gold);margin-top:4px;letter-spacing:1px}
.role-desc{font-size:12px;color:var(--dim);margin-top:8px;line-height:1.6}
.role-tag{display:inline-block;margin-top:10px;padding:2px 10px;font-size:10px;border:1px solid rgba(212,175,55,.3);border-radius:10px;color:var(--gold);letter-spacing:1px}

/* 作品矩阵 */
.matrix{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px}
.mat-card{display:block;background:linear-gradient(135deg,var(--ink3),var(--ink2));border:1px solid rgba(212,175,55,.2);border-radius:14px;padding:26px;transition:all .3s;position:relative;overflow:hidden}
.mat-card::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:var(--gold);transform:scaleY(0);transform-origin:top;transition:transform .3s}
.mat-card:hover::before{transform:scaleY(1)}
.mat-card:hover{transform:translateY(-4px);border-color:var(--gold);box-shadow:0 10px 30px rgba(212,175,55,.12)}
.mat-icon{font-size:28px;margin-bottom:12px}
.mat-title{font-size:17px;color:var(--gold2);letter-spacing:3px;font-weight:700}
.mat-desc{font-size:12px;color:var(--dim);margin-top:8px;line-height:1.7}
.mat-arrow{margin-top:14px;font-size:12px;color:var(--gold);letter-spacing:2px}

/* 数字凭证 */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;margin-top:20px}
.stat{background:var(--ink3);border:1px solid rgba(212,175,55,.15);border-radius:12px;padding:22px;text-align:center}
.stat-num{font-size:32px;font-weight:800;color:var(--gold);font-variant-numeric:tabular-nums}
.stat-label{font-size:11px;color:var(--dim);letter-spacing:2px;margin-top:6px}

/* 底部 */
